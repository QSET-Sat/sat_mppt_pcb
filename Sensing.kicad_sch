			)
			(justify left top)
		)
		(uuid "6623572e-782b-4ddc-8da7-d052dd9d22a0")
	)
	(text_box "Current limit: I_lim = 13.33/R_ILM(kohm) = 13.33/10 = 1.33 A\n\nOutput Slew rate(dV/dt = 500/C_(dV/dt)(pF)) = 500/100 = 5 V/ms\n\nfor the Itimer:: t = C_ITIMER*0.2 = 2.2*0.2 = 0.44ms\n\nFor OVLO and UVLO, this will turn on when the voltage is above 4.41V and below 5.85V"
		(exclude_from_sim no)
		(at 392.43 224.79 0)
		(size 50.8 26.67)
